// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`App > shows QR code when a username is set 1`] = `
<div>
  <div
    class="app"
  >
    <div
      class="qr-screen"
    >
      <div
        class="qr-container"
      >
        <h2>
          @
          ekohilas
        </h2>
        <div
          class="qr-code-wrapper"
        >
          <img
            alt="LinkedIn QR Code"
            class="qr-code"
            src="data:image/png;base64,mockqrcode"
          />
          <p
            class="tap-hint"
          >
            👆 Tap to take a selfie
          </p>
        </div>
        
      </div>
    </div>
    
  </div>
</div>
`;

exports[`App > shows QR instructions when no username is set 1`] = `
<div>
  <div
    class="app"
  >
    <div
      class="qr-screen"
    >
      <div
        class="qr-instructions"
      >
        <h1>
          LinkedInSnap
        </h1>
        <p>
          Add your LinkedIn username to the URL:
        </p>
        <code>
          #{username}
        </code>
        <p
          class="example"
        >
          Example: #ekohilas
        </p>
      </div>
    </div>
    
  </div>
</div>
`;

exports[`App > switches to camera screen when QR code is tapped 1`] = `
<div>
  <div
    class="app"
  >
    
    <div
      class="camera-screen"
    >
      
      <div
        class="loading-overlay"
      >
        <p>
          Loading camera...
        </p>
      </div>
      <video
        autoplay=""
        class="camera-video"
        muted=""
        playsinline=""
      />
      <canvas
        style="display:none"
      />
      <div
        class="camera-overlay"
      >
        <div
          class="tap-instruction"
        >
          👆 Tap to capture
        </div>
      </div>
      
    </div>
  </div>
</div>
`;
